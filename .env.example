# ==============================================================================
# MSK Institute Website - Environment Configuration Example
# ==============================================================================

# Canonical Website URL
NEXT_PUBLIC_SITE_URL="https://www.mskinstitute.in"

# Google Sheet URL for Live Classroom Timetable
# 1. Share your Google Sheet as "Anyone with the link can view"
# 2. Paste the share link, edit link, or published CSV link here:
# Columns in Google Sheet: courseid, date, startTime, endTime, joinUrl, chapter
GOOGLE_SHEET_LIVE_CLASSES_URL="https://docs.google.com/spreadsheets/d/1IMLDtXqnuM1A35xpboR_IrcYh5563ZCy55dzl1vGW1A/edit?usp=sharing"
NEXT_PUBLIC_GOOGLE_SHEET_LIVE_CLASSES_URL="https://docs.google.com/spreadsheets/d/1IMLDtXqnuM1A35xpboR_IrcYh5563ZCy55dzl1vGW1A/edit?usp=sharing"

# Google Sheet URL for Live Batches (Batches Tab)
# Columns in Google Sheet: courseid, title, startdatetime, schedule, instructorId, price, originalPrice, totalSeats, leftSeats
GOOGLE_SHEET_LIVE_BATCHES_URL="https://docs.google.com/spreadsheets/d/1IMLDtXqnuM1A35xpboR_IrcYh5563ZCy55dzl1vGW1A/edit?gid=1194716609#gid=1194716609"
NEXT_PUBLIC_GOOGLE_SHEET_LIVE_BATCHES_URL="https://docs.google.com/spreadsheets/d/1IMLDtXqnuM1A35xpboR_IrcYh5563ZCy55dzl1vGW1A/edit?gid=1194716609#gid=1194716609"

# Optional: Google Sheet Webhook URL for lead capture forwarding
# GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# ==============================================================================
# Google Ecosystem & Tracking Configuration
# ==============================================================================
# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXXX"

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google Search Console HTML Verification Token
# Retrieved from Google Search Console > Settings > Ownership verification > HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="YOUR_GOOGLE_SITE_VERIFICATION_TOKEN"
